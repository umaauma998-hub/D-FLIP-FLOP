`timescale 1ns/1ps

module d_flipflop_tb;

reg clk;
reg d;
wire q;

d_flipflop uut (
    .clk(clk),
    .d(d),
    .q(q)
);

always #5 clk = ~clk;

initial
begin
    clk = 0;
    d = 0;

    #10 d = 1;
    #10 d = 0;
    #10 d = 1;
    #10 d = 0;

    #20 $finish;
end

initial
begin
    $monitor("Time=%0t clk=%b d=%b q=%b",
              $time, clk, d, q);
end

endmodule